# Server only: copy this file to .env.local. Never commit real keys.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Required for production AI access. Browser prompts for a username (any) and this password.
APP_PASSWORD=

# OpenAI cloud speech; falls back to AI_API_KEY only when AI_BASE_URL is OpenAI.
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# 私有 Vercel Blob：连接项目后由平台自动配置，优先使用 OIDC。
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=
# 仅本地开发需要自备私有存储读写 token，勿提交真实值。
# BLOB_READ_WRITE_TOKEN=
